{
  // 监听地址与端口。0.0.0.0 = 所有网卡。
  "server": {
    "host": "0.0.0.0",
    "port": 7777,
    "name": "Bunny Loader Server"
  },

  // 日志级别：debug / info / warn / error。
  // dumpBytes=true 时，每次收到数据都记一条 conn.bytes（含首 8 字节十六进制）。
  "logging": {
    "level": "info",
    "dumpBytes": true
  },

  // 这三项对应游戏里 Host 界面的开关。
  // 本轮只加载打印，不参与任何判定（判定在 R2 实现）。
  "rules": {
    "syncMods": true,
    "allowTextures": true,
    "allowCheats": true,
    "password": ""
  },

  // 服务端「认定」的模组集，顺序即契约（顺序决定物品/NPC/弹幕编号）。
  // 比对键：uid + version，逐位保序；空版本视为不兼容。
  "mods": [
    // {
    //   "uid": "examplemod",
    //   "id": "ExampleMod",
    //   "name": "Example Mod",
    //   "version": "1.0.0"
    // }
  ],

  // 消息 7 的世界头。R2 只发世界头，方块数据在 R3。
  // spawnTile 必须落在 maxTiles 之内（加载配置时会校验）。
  "world": {
    "name": "Bunny World",
    "maxTilesX": 4200,
    "maxTilesY": 1200,
    "spawnTileX": 2100,
    "spawnTileY": 300,
    "worldSurface": 350,
    "rockLayer": 500,
    "dungeonX": 0,
    "dungeonY": 0,
    "crimson": false,
    "gameMode": 0,
    "release326": true,
    "seed": 1
  },

  // 消息 3 的形态。
  //   flags = u8 槽位 + u8 bool（桌面 1.4.5）
  //   slot  = 只有 u8 槽位（1.4.4 / 可能的移动端）
  // V1 失败（发了 3 之后客户端一个包都不回）时，把这里改成 "slot" 再连一次，不必重新构建。
  "handshake": {
    "connectionApproved": "flags"
  }
}
