{
  // 监听地址与端口。0.0.0.0 = 所有网卡。
  "server": {
    "host": "0.0.0.0",
    "port": 7777,
    "name": "Bunny Loader Server"
  },

  // 日志级别：debug / info / warn / error。
  // dumpBytes=true 时，每次收到数据都记一条 conn.bytes（含首 8 字节十六进制）。
  "logging": {
    "level": "info",
    "dumpBytes": true
  },

  // 这三项对应游戏里 Host 界面的开关。
  // 本轮只加载打印，不参与任何判定（判定在 R2 实现）。
  "rules": {
    "syncMods": true,
    "allowTextures": true,
    "allowCheats": true,
    "password": ""
  },

  // 服务端「认定」的模组集，顺序即契约（顺序决定物品/NPC/弹幕编号）。
  // 比对键：uid + version，逐位保序；空版本视为不兼容。
  "mods": [
    // {
    //   "uid": "examplemod",
    //   "id": "ExampleMod",
    //   "name": "Example Mod",
    //   "version": "1.0.0"
    // }
  ],

  // 消息 7 的世界头。R2 只发世界头，方块数据在 R3。
  // spawnTile 必须落在 maxTiles 之内（加载配置时会校验）。
  "world": {
    "name": "Bunny World",
    "maxTilesX": 4200,
    "maxTilesY": 1200,
    "spawnTileX": 2100,
    "spawnTileY": 349,
    "worldSurface": 350,
    "rockLayer": 500,
    "dungeonX": 0,
    "dungeonY": 0,
    "crimson": false,
    "gameMode": 0,
    "release326": true,
    "seed": 1
  },

  // 消息 3 的形态。两个独立维度：
  //   layout      flags = 槽位 + bool（2 字节，1.4.5）；slot = 只有槽位（1 字节，1.4.4）
  //   specialFlag 那个 bool 的值：true 发 0x01，false 发 0x00
  //   auto        true 时每次连接轮换：第 1 次 flags+true，第 2 次 slot，第 3 次 flags+false
  // 现场测试建议保持 auto，连三次就知道哪种能进。
  "handshake": {
    "layout": "flags",
    "specialFlag": true,
    "auto": true
  }
}
